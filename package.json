{
  "name": "dsbot-remote",
  "version": "0.1.1",
  "type": "module",
  "description": "Remote Bot for DS Bot: another computer's Bot joins the group chat, pushes its own files, runs its own commands. 粘 https://github.com/maxmilk2197/dsbot-remote 就能装。 （AI 生成，请勿用于生产环境 / AI-generated, not for production use）",
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    ".": "./packages/dsbot-nodes/src/host/nodes/index.js",
    "./adapter": "./packages/dsbot-nodes/src/host/nodes/adapter.js",
    "./client": "./packages/dsbot-nodes/client.js",
    "./node": "./packages/dsbot-nodes/src/node/cli.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsbot-remote": "./packages/dsbot-nodes/bin/dsbot-remote.js"
  },
  "files": [
    "packages/dsbot-nodes",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test --test-timeout=30000 \"packages/*/test/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "MIT"
}
